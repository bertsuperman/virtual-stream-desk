<Window x:Class="VirtualStreamDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VirtualStreamDeck.App"
        Title="Stream Deck"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        ShowInTaskbar="True"
        ThemeMode="Dark"
        Background="#FF17171A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="#FF9A9AA4" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2C2C33" />
                                <Setter Property="Foreground" Value="#FFEDEDF2" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A3550" />
                                <Setter Property="Foreground" Value="#FF8DB4FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The deck -->
        <Grid Grid.Column="0" VerticalAlignment="Top">
            <UniformGrid x:Name="DeckGrid" Margin="8" />
            <Border x:Name="StatusToast"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="10"
                    Padding="12,7"
                    CornerRadius="8"
                    Background="#F0242429"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" MaxWidth="360" />
            </Border>
        </Grid>

        <!-- Rail: opens the side panel -->
        <Border Grid.Column="1" Background="#FF1C1C21" BorderBrush="#FF2A2A30" BorderThickness="1,0,1,0">
            <StackPanel Margin="5,8,5,8">
                <Button x:Name="ProfilesRailButton" Style="{StaticResource RailButton}" Content="&#xE81E;"
                        ToolTip="Profily" Click="ProfilesRail_Click" />
                <Button x:Name="SettingsRailButton" Style="{StaticResource RailButton}" Content="&#xE713;"
                        ToolTip="Nastavenia" Click="SettingsRail_Click" />
                <Button x:Name="GuideRailButton" Style="{StaticResource RailButton}" Content="&#xE897;"
                        ToolTip="Návod" Click="GuideRail_Click" />
                <!-- Shown only when a newer version is on GitHub -->
                <Button x:Name="UpdateRailButton" Style="{StaticResource RailButton}" Content="&#xE896;"
                        Foreground="#FF5CCB6E" Visibility="Collapsed" Click="UpdateRail_Click" />
            </StackPanel>
        </Border>

        <!-- Side panel: settings, profiles, guide -->
        <local:SettingsPanel x:Name="SidePanel" Grid.Column="2" Width="470" Height="580" Visibility="Collapsed" />
    </Grid>
</Window>
