<Window x:Class="VirtualStreamDeck.App.ButtonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:VirtualStreamDeck.App.Controls"
        Title="Tlačidlo"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ThemeMode="Dark">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Icon -->
        <TextBlock Grid.Row="0" Text="Ikona" Style="{StaticResource FieldLabel}" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Border x:Name="IconDrop"
                    Width="76" Height="76"
                    CornerRadius="12"
                    Background="#FF26262C"
                    BorderBrush="#FF3A3A42"
                    BorderThickness="1"
                    AllowDrop="True"
                    DragOver="IconDrop_DragOver"
                    Drop="IconDrop_Drop"
                    ToolTip="Sem môžeš pretiahnuť obrázok alebo program">
                <Grid>
                    <Image x:Name="IconImage" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="IconPlaceholder"
                               Text="&#xE91B;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="26"
                               Foreground="#FF6C6C75"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <Button Content="Vybrať obrázok…" Click="PickIcon_Click" Margin="0,0,0,8" MinWidth="150" />
                <Button Content="Bez ikony" Click="ClearIcon_Click" MinWidth="150" />
            </StackPanel>
        </StackPanel>

        <!-- Label -->
        <TextBlock Grid.Row="1" Text="Popis" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LabelBox" Margin="0,0,0,14" />

        <!-- Action type -->
        <TextBlock Grid.Row="2" Text="Akcia" Style="{StaticResource FieldLabel}" />
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ActionTypeBox" Margin="0,0,0,14"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="ActionTypeBox_SelectionChanged">
            <ComboBoxItem Tag="open" Content="Otvoriť program, súbor alebo web" />
            <ComboBoxItem Tag="keys" Content="Stlačiť klávesovú skratku" />
            <ComboBoxItem Tag="media" Content="Médiá a hlasitosť" />
            <ComboBoxItem Tag="obs" Content="OBS Studio" />
        </ComboBox>

        <!-- Action details -->
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,18">
            <StackPanel x:Name="OpenPanel">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Priečinok…" Click="BrowseFolder_Click" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Súbor…" Click="BrowseFile_Click" Margin="6,0,0,0" />
                    <TextBox x:Name="TargetBox" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Program, odkaz, súbor, priečinok alebo adresa webu (https://…)." />
                <TextBlock Text="Argumenty (nepovinné)" Margin="0,12,0,6" Opacity="0.85" />
                <TextBox x:Name="ArgsBox" />
            </StackPanel>

            <StackPanel x:Name="KeysPanel" Visibility="Collapsed">
                <c:HotkeyBox x:Name="KeysBox" />
                <TextBlock Style="{StaticResource Hint}" Text="Skratka sa pošle do okna, v ktorom práve pracuješ (napr. Ctrl+Shift+M pre mute v Teams)." />
            </StackPanel>

            <StackPanel x:Name="MediaPanel" Visibility="Collapsed">
                <ComboBox x:Name="MediaBox" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel x:Name="ObsPanel" Visibility="Collapsed">
                <ComboBox x:Name="ObsCommandBox" HorizontalAlignment="Stretch"
                          SelectionChanged="ObsCommandBox_SelectionChanged" />

                <StackPanel x:Name="ObsSceneRow" Margin="0,12,0,0">
                    <TextBlock x:Name="ObsSceneLabel" Text="Scéna" Margin="0,0,0,6" Opacity="0.85" />
                    <ComboBox x:Name="ObsSceneBox" IsEditable="True" HorizontalAlignment="Stretch"
                              SelectionChanged="ObsSceneBox_SelectionChanged" />
                </StackPanel>

                <StackPanel x:Name="ObsSourceRow" Margin="0,12,0,0">
                    <TextBlock x:Name="ObsSourceLabel" Text="Zdroj" Margin="0,0,0,6" Opacity="0.85" />
                    <ComboBox x:Name="ObsSourceBox" IsEditable="True" HorizontalAlignment="Stretch" />
                </StackPanel>

                <DockPanel x:Name="ObsRefreshRow" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Načítať z OBS" Click="ObsRefresh_Click" Margin="10,0,0,0" />
                    <TextBlock x:Name="ObsStatus" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Grid>

        <!-- Global hotkey -->
        <TextBlock Grid.Row="4" Text="Klávesová&#x0a;skratka" Style="{StaticResource FieldLabel}" />
        <DockPanel Grid.Row="4" Grid.Column="1">
            <Button DockPanel.Dock="Right" Content="Zrušiť" Click="ClearHotkey_Click" Margin="6,0,0,0" />
            <c:HotkeyBox x:Name="GlobalHotkeyBox" />
        </DockPanel>
        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,6,0,20" />

        <!-- Buttons -->
        <DockPanel Grid.Row="6" Grid.ColumnSpan="2" LastChildFill="False">
            <Button DockPanel.Dock="Left" x:Name="DeleteButton" Content="Vymazať tlačidlo" Click="Delete_Click" />
            <Button DockPanel.Dock="Right" Content="Zrušiť" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Uložiť" IsDefault="True" Click="Save_Click" MinWidth="90" />
        </DockPanel>
    </Grid>
</Window>
