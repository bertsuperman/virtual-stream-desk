<UserControl x:Class="VirtualStreamDeck.App.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:VirtualStreamDeck.App"
             Background="#FF1C1C21">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="GuideTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style x:Key="GuideText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="16,12,8,10">
            <Button DockPanel.Dock="Right" Click="Collapse_Click" ToolTip="{l:T 'Zbaliť panel', 'Collapse panel'}" Padding="8,4"
                    FontFamily="{StaticResource IconFont}" FontSize="12" Content="&#xE76B;" />
            <TextBlock x:Name="PanelTitle" Text="{l:T 'Nastavenia', 'Settings'}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Navigation -->
        <ListBox x:Name="Nav" DockPanel.Dock="Left" Width="132" Margin="8,0,0,12"
                 BorderThickness="0" Background="Transparent" SelectionChanged="Nav_SelectionChanged">
            <ListBoxItem Tag="profiles">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE81E;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                    <TextBlock Text="{l:T 'Profily', 'Profiles'}" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="layout">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                    <TextBlock Text="{l:T 'Rozloženie', 'Layout'}" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="general">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                    <TextBlock Text="{l:T 'Všeobecné', 'General'}" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="phone">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                    <TextBlock Text="{l:T 'Mobil', 'Phone'}" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="obs">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                    <TextBlock Text="OBS" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="guide">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                    <TextBlock Text="{l:T 'Návod', 'Guide'}" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="16,0,16,12" FontSize="11"
                   Text="{l:T 'Kým je panel otvorený, deck sa správa ako bežné okno (dá sa doň písať). Skratky z tlačidiel pôjdu správne do iných appiek, keď panel zbalíš.', 'While the panel is open, the deck behaves like a normal window (you can type in it). Key buttons go to other apps correctly once you collapse the panel.'}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,0,4,8">
            <Grid Margin="12,0,16,8">

                <!-- ───────────── Profily ───────────── -->
                <StackPanel x:Name="ProfilesSection">
                    <TextBlock Text="{l:T 'Profily', 'Profiles'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="{l:T 'Klikni na profil a deck sa naň prepne. Každý profil má vlastné tlačidlá a mriežku.', 'Click a profile to switch to it. Each profile has its own buttons and grid.'}" />
                    <ListBox x:Name="ProfileList" MaxHeight="210" Margin="0,0,0,12" SelectionChanged="ProfileList_SelectionChanged" />

                    <TextBlock Text="{l:T 'Názov aktívneho profilu', 'Name of the active profile'}" Margin="0,0,0,6" Opacity="0.85" />
                    <TextBox x:Name="ProfileNameBox" Margin="0,0,0,12" />

                    <WrapPanel>
                        <Button Content="{l:T 'Nový profil', 'New profile'}" Click="ProfileNew_Click" Margin="0,0,8,8" />
                        <Button Content="{l:T 'Duplikovať', 'Duplicate'}" Click="ProfileDuplicate_Click" Margin="0,0,8,8" />
                        <Button Content="{l:T 'Vymazať', 'Delete'}" Click="ProfileDelete_Click" Margin="0,0,8,8" />
                        <Button Content="{l:T 'Profil so zvukom', 'Sound profile'}" Click="ProfileSound_Click" Margin="0,0,0,8"
                                ToolTip="{l:T 'Nový profil s tlačidlami na hlasitosť a prehrávanie', 'New profile with volume and playback buttons'}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="{l:T 'Tip: tlačidlo s akciou „Prepnúť profil“ funguje ako priečinok. V cieľovom profile si daj tlačidlo späť.', 'Tip: a button with the action &quot;Switch profile&quot; works like a folder. Put a button back in the target profile.'}" />
                </StackPanel>

                <!-- ───────────── Rozloženie ───────────── -->
                <StackPanel x:Name="LayoutSection" Visibility="Collapsed">
                    <TextBlock x:Name="GridTitle" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{l:T 'Riadky', 'Rows'}" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="RowsSlider" Minimum="1" Maximum="10"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Value}"
                                   Text="{Binding Value, ElementName=RowsSlider, StringFormat={}{0:0}}" />
                        <TextBlock Grid.Row="1" Text="{l:T 'Stĺpce', 'Columns'}" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="ColumnsSlider" Minimum="1" Maximum="12"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"
                                   Text="{Binding Value, ElementName=ColumnsSlider, StringFormat={}{0:0}}" />
                    </Grid>
                    <TextBlock x:Name="HiddenInfo" Style="{StaticResource Hint}" Margin="0,0,0,20" />

                    <TextBlock Text="{l:T 'Vzhľad (všetky profily)', 'Look (all profiles)'}" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{l:T 'Veľkosť', 'Size'}" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="SizeSlider" Minimum="40" Maximum="200"
                                TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Value}"
                                   Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0}}" />
                        <TextBlock Grid.Row="1" Text="{l:T 'Medzery', 'Spacing'}" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="SpacingSlider" Minimum="0" Maximum="40"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"
                                   Text="{Binding Value, ElementName=SpacingSlider, StringFormat={}{0:0}}" />
                    </Grid>
                    <CheckBox x:Name="LabelsBox" Content="{l:T 'Popisky pod ikonami', 'Labels under icons'}" />
                </StackPanel>

                <!-- ───────────── Všeobecné ───────────── -->
                <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
                    <TextBlock Text="{l:T 'Všeobecné', 'General'}" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Jazyk / Language" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" x:Name="LanguageBox" Width="160" HorizontalAlignment="Left">
                            <ComboBoxItem Tag="sk" Content="Slovenčina" />
                            <ComboBoxItem Tag="en" Content="English" />
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="TopmostBox" Content="{l:T 'Vždy navrchu', 'Always on top'}" Margin="0,0,0,6" />
                    <CheckBox x:Name="AutostartBox" Content="{l:T 'Spustiť so systémom Windows', 'Start with Windows'}" Margin="0,0,0,20" />

                    <TextBlock Text="{l:T 'Aktualizácie', 'Updates'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <CheckBox x:Name="AutoUpdateBox" Content="{l:T 'Kontrolovať nové verzie automaticky', 'Check for new versions automatically'}" Margin="0,0,0,8" />
                    <Button x:Name="UpdateButton" Content="{l:T 'Skontrolovať teraz', 'Check now'}" HorizontalAlignment="Left" Click="Update_Click" />
                    <TextBlock x:Name="UpdateStatus" Margin="0,8,0,4" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,20"
                               Text="{l:T 'Novú verziu stiahne priamo Stream Deck, takže Windows pri spustení nevyskočí s varovaním.', 'Stream Deck downloads the new version itself, so Windows does not warn when it starts.'}" />

                    <TextBlock Text="{l:T 'Konfigurácia', 'Configuration'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="{l:T 'Tlačidlá, profily, ikony a nastavenia sú v jednom priečinku. Na zálohu ho stačí skopírovať.', 'Buttons, profiles, icons and settings are in one folder. Copy it to make a backup.'}" />
                    <Button Content="{l:T 'Otvoriť priečinok s nastaveniami', 'Open the settings folder'}" HorizontalAlignment="Left" Click="OpenFolder_Click" />

                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,24,0,0" />
                </StackPanel>

                <!-- ───────────── Mobil ───────────── -->
                <StackPanel x:Name="PhoneSection" Visibility="Collapsed">
                    <TextBlock Text="{l:T 'Ovládanie z mobilu', 'Phone control'}" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="RemoteEnabledBox" Content="{l:T 'Povoliť ovládanie z mobilu', 'Allow control from a phone'}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                               Text="{l:T 'Mobil musí byť v rovnakej Wi-Fi. Nič sa neinštaluje, beží to v prehliadači.', 'The phone must be on the same Wi-Fi. Nothing to install, it runs in the browser.'}" />

                    <StackPanel x:Name="RemotePanel">
                        <Border Width="190" Height="190" Background="White" CornerRadius="10" HorizontalAlignment="Left">
                            <Image x:Name="QrImage" Margin="6" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <TextBlock Text="{l:T 'Naskenuj kód fotoaparátom mobilu.', 'Scan the code with the phone camera.'}" FontWeight="SemiBold" Margin="0,10,0,12" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:T 'Adresa PC', 'PC address'}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" x:Name="AddressBox" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="1" Text="Port" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="RemotePortBox" Width="90" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </Grid>
                        <WrapPanel>
                            <Button Content="{l:T 'Kopírovať odkaz', 'Copy link'}" Click="CopyUrl_Click" Margin="0,0,8,8" />
                            <Button Content="{l:T 'Nový kód', 'New code'}" Click="NewToken_Click" Margin="0,0,0,8"
                                    ToolTip="{l:T 'Vytvorí nový QR kód. Zariadenia so starým kódom sa odpoja.', 'Creates a new QR code. Devices with the old code are disconnected.'}" />
                        </WrapPanel>
                        <TextBox x:Name="UrlBox" IsReadOnly="True" Margin="0,4,0,0" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="RemoteStatus" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="{l:T 'Ak sa mobil nevie pripojiť, povoľ Stream Deck vo Windows Firewall pre súkromné siete. Viac v Návode.', 'If the phone cannot connect, allow Stream Deck in Windows Firewall for private networks. More in the Guide.'}" />
                </StackPanel>

                <!-- ───────────── OBS ───────────── -->
                <StackPanel x:Name="ObsSection" Visibility="Collapsed">
                    <TextBlock Text="OBS Studio" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                               Text="{l:T 'V OBS zapni Nástroje → Nastavenia WebSocket servera → Povoliť WebSocket server. Postup krok za krokom je v Návode.', 'In OBS turn on Tools → WebSocket Server Settings → Enable WebSocket server. Step by step in the Guide.'}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:T 'Adresa', 'Address'}" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" x:Name="ObsHostBox" />
                        <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox Grid.Column="3" x:Name="ObsPortBox" />
                        <TextBlock Grid.Row="1" Text="{l:T 'Heslo', 'Password'}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <PasswordBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ObsPasswordBox" Margin="0,10,0,0" />
                    </Grid>
                    <Button Content="{l:T 'Otestovať pripojenie', 'Test connection'}" HorizontalAlignment="Left" Click="ObsTest_Click" />
                    <TextBlock x:Name="ObsStatus" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>

                <!-- ───────────── Návod / Guide ───────────── -->
                <StackPanel x:Name="GuideSection" Visibility="Collapsed">
                    <StackPanel x:Name="GuideSk">
                        <TextBlock Text="Návod" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Ako to funguje" Style="{StaticResource GuideTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource GuideText}">
                            Deck je mriežka tlačidiel. Každé tlačidlo robí jednu vec: otvorí program alebo web, stlačí klávesovú skratku,
                            ovláda hudbu, OBS alebo prepne profil. Okno decku si nevezme focus, takže skratka z tlačidla ide do appky,
                            v ktorej práve pracuješ.
                        </TextBlock>

                        <TextBlock Text="Tlačidlá" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            • <Bold>Pridať:</Bold> pretiahni program, odkaz, priečinok alebo adresu z prehliadača na mriežku. Alebo klikni na prázdne políčko.<LineBreak />
                            • <Bold>Upraviť / vymazať:</Bold> pravý klik na tlačidlo.<LineBreak />
                            • <Bold>Presunúť:</Bold> chyť tlačidlo myšou a pusti na iné políčko.<LineBreak />
                            • <Bold>Ikona:</Bold> v editore pretiahni obrázok alebo program na náhľad ikony.
                        </TextBlock>

                        <TextBlock Text="Klávesové skratky" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            V editore tlačidla klikni do poľa <Bold>Klávesová skratka</Bold> a stlač kombináciu (napr. Ctrl+Alt+1).
                            Tlačidlo sa potom spustí touto skratkou kdekoľvek, aj keď je deck schovaný. Bez Ctrl/Alt/Shift sa hodia
                            klávesy F13–F24 alebo numerická klávesnica.
                        </TextBlock>

                        <TextBlock Text="Profily" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            Profil je samostatná sada tlačidiel, napr. „Hry“, „Stream“, „Práca“. Vytvoríš ho v sekcii Profily,
                            prepneš kliknutím na jeho názov, z mobilu alebo tlačidlom s akciou <Bold>Prepnúť profil</Bold>.
                            <Bold>Profil so zvukom</Bold> pridá hotový profil s tlačidlami na hlasitosť a prehrávanie.
                        </TextBlock>

                        <TextBlock Text="Pripojenie OBS" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            1. V OBS otvor <Bold>Nástroje → Nastavenia WebSocket servera</Bold>.<LineBreak />
                            2. Zaškrtni <Bold>Povoliť WebSocket server</Bold> a potvrď.<LineBreak />
                            3. Klikni na <Bold>Zobraziť informácie o pripojení</Bold> a skopíruj heslo.<LineBreak />
                            4. Tu v sekcii <Bold>OBS</Bold> vlož heslo (adresa localhost, port 4455) a klikni na Otestovať pripojenie.<LineBreak />
                            5. Pri tlačidle vyber akciu <Bold>OBS Studio</Bold>. Scény a zdroje sa načítajú priamo z OBS.<LineBreak />
                            Ak OBS beží na inom PC, zadaj jeho IP adresu namiesto localhost.
                        </TextBlock>

                        <TextBlock Text="Ovládanie z mobilu" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            1. Mobil aj PC musia byť v <Bold>rovnakej Wi-Fi</Bold>.<LineBreak />
                            2. V sekcii <Bold>Mobil</Bold> zaškrtni Povoliť ovládanie z mobilu.<LineBreak />
                            3. Ak sa Windows opýta na prístup do siete, povoľ <Bold>súkromné siete</Bold>.<LineBreak />
                            4. Naskenuj QR kód fotoaparátom mobilu a otvor odkaz.<LineBreak />
                            5. V prehliadači daj <Bold>Pridať na plochu</Bold>, odvtedy sa deck otvorí ako appka na celú obrazovku.<LineBreak />
                            Deck sa v mobile sám zobrazí na šírku. Ak sa mobil nepripojí, skús inú adresu PC v sekcii Mobil
                            alebo skontroluj Windows Firewall (Nastavenia Windows → Ochrana → Brána firewall → Povoliť aplikáciu).
                            Tlačidlo <Bold>Nový kód</Bold> odpojí všetky mobily.
                        </TextBlock>

                        <TextBlock Text="Okno a lišta" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            Klik na ikonu v lište vedľa hodín deck schová alebo ukáže, appka beží ďalej a skratky fungujú.
                            Krížik okno úplne ukončí (opýta sa). Keď vyjde nová verzia, v pruhu s ikonami sa objaví
                            <Bold>zelená šípka</Bold>. Klikni na ňu a Stream Deck sa sám aktualizuje a znova spustí.
                        </TextBlock>
                
                    </StackPanel>

                    <StackPanel x:Name="GuideEn" Visibility="Collapsed">
                        <TextBlock Text="Guide" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="How it works" Style="{StaticResource GuideTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource GuideText}">
                            The deck is a grid of buttons. Each button does one thing: opens a program or website, presses a key
                            combination, controls music or OBS, or switches the profile. The deck window never takes the focus, so keys
                            from a button go to the app you are working in.
                        </TextBlock>

                        <TextBlock Text="Buttons" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            • <Bold>Add:</Bold> drop a program, shortcut, folder or a link from the browser on the grid. Or click an empty cell.<LineBreak />
                            • <Bold>Edit / delete:</Bold> right-click the button.<LineBreak />
                            • <Bold>Move:</Bold> drag the button onto another cell.<LineBreak />
                            • <Bold>Icon:</Bold> in the editor, drop a picture or program on the icon preview.
                        </TextBlock>

                        <TextBlock Text="Hotkeys" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            In the button editor click the <Bold>Hotkey</Bold> field and press a combination (e.g. Ctrl+Alt+1).
                            The button then runs from anywhere with this hotkey, even when the deck is hidden. Without Ctrl/Alt/Shift,
                            use F13–F24 or the numeric keypad.
                        </TextBlock>

                        <TextBlock Text="Profiles" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            A profile is a separate set of buttons, e.g. "Games", "Stream", "Work". Create one in Profiles,
                            switch by clicking its name, from the phone, or with a button using the action <Bold>Switch profile</Bold>.
                            <Bold>Sound profile</Bold> adds a ready-made profile with volume and playback buttons.
                        </TextBlock>

                        <TextBlock Text="Connecting OBS" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            1. In OBS open <Bold>Tools → WebSocket Server Settings</Bold>.<LineBreak />
                            2. Check <Bold>Enable WebSocket server</Bold> and confirm.<LineBreak />
                            3. Click <Bold>Show Connect Info</Bold> and copy the password.<LineBreak />
                            4. Here in <Bold>OBS</Bold> paste the password (address localhost, port 4455) and click Test connection.<LineBreak />
                            5. For a button choose the action <Bold>OBS Studio</Bold>. Scenes and sources are loaded from OBS.<LineBreak />
                            If OBS runs on another PC, enter its IP address instead of localhost.
                        </TextBlock>

                        <TextBlock Text="Phone control" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            1. The phone and the PC must be on the <Bold>same Wi-Fi</Bold>.<LineBreak />
                            2. In <Bold>Phone</Bold> check Allow control from a phone.<LineBreak />
                            3. If Windows asks about network access, allow <Bold>private networks</Bold>.<LineBreak />
                            4. Scan the QR code with the phone camera and open the link.<LineBreak />
                            5. In the browser choose <Bold>Add to Home Screen</Bold>, then the deck opens full screen like an app.<LineBreak />
                            On the phone the deck turns to landscape by itself. If the phone does not connect, try another PC address in Phone
                            or check Windows Firewall (Windows Settings → Privacy &amp; security → Windows Security → Firewall → Allow an app).
                            <Bold>New code</Bold> disconnects all phones.
                        </TextBlock>

                        <TextBlock Text="Window and tray" Style="{StaticResource GuideTitle}" />
                        <TextBlock Style="{StaticResource GuideText}">
                            Clicking the tray icon next to the clock hides or shows the deck, the app keeps running and hotkeys work.
                            The close button quits the app (it asks first). When a new version is out, a <Bold>green arrow</Bold>
                            appears in the icon bar. Click it and Stream Deck updates and restarts itself.
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
