<Window x:Class="VirtualStreamDeck.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastavenia"
        Width="560"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ThemeMode="Dark">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,12,16,16">
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Zavrieť" IsCancel="True" IsDefault="True" MinWidth="90" />
        </DockPanel>

        <TabControl x:Name="Tabs">
            <!-- ───────────── Všeobecné ───────────── -->
            <TabItem Header="Všeobecné">
                <StackPanel Margin="8,16,8,8">
                    <CheckBox x:Name="TopmostBox" Content="Vždy navrchu" Margin="0,0,0,6" />
                    <CheckBox x:Name="AutostartBox" Content="Spustiť so systémom Windows" Margin="0,0,0,20" />

                    <TextBlock Text="Konfigurácia" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Tlačidlá, profily, ikony a nastavenia sú v jednom priečinku. Na zálohu ho stačí skopírovať." />
                    <Button Content="Otvoriť priečinok s nastaveniami" HorizontalAlignment="Left" Click="OpenFolder_Click" />

                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,28,0,0" />
                </StackPanel>
            </TabItem>

            <!-- ───────────── Rozloženie ───────────── -->
            <TabItem Header="Rozloženie">
                <StackPanel Margin="8,12,8,8">
                    <TextBlock x:Name="GridTitle" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Riadky" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="RowsSlider" Minimum="1" Maximum="10"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Value}"
                                   Text="{Binding Value, ElementName=RowsSlider, StringFormat={}{0:0}}" />
                        <TextBlock Grid.Row="1" Text="Stĺpce" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="ColumnsSlider" Minimum="1" Maximum="12"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"
                                   Text="{Binding Value, ElementName=ColumnsSlider, StringFormat={}{0:0}}" />
                    </Grid>
                    <TextBlock x:Name="HiddenInfo" Style="{StaticResource Hint}" Margin="0,0,0,18" />

                    <TextBlock Text="Vzhľad (všetky profily)" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Veľkosť tlačidiel" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="SizeSlider" Minimum="40" Maximum="200"
                                TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Value}"
                                   Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0}}" />
                        <TextBlock Grid.Row="1" Text="Medzery" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="SpacingSlider" Minimum="0" Maximum="40"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"
                                   Text="{Binding Value, ElementName=SpacingSlider, StringFormat={}{0:0}}" />
                    </Grid>
                    <CheckBox x:Name="LabelsBox" Content="Zobrazovať popisky pod ikonami" />
                </StackPanel>
            </TabItem>

            <!-- ───────────── Profily ───────────── -->
            <TabItem Header="Profily">
                <DockPanel Margin="8,16,8,8">
                    <StackPanel DockPanel.Dock="Right" Width="140" Margin="12,0,0,0">
                        <Button Content="Prepnúť naň" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="ProfileActivate_Click" />
                        <Button Content="Nový" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="ProfileNew_Click" />
                        <Button Content="Duplikovať" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="ProfileDuplicate_Click" />
                        <Button Content="Vymazať" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="ProfileDelete_Click" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="Názov vybraného profilu" Margin="0,0,0,6" Opacity="0.85" />
                        <TextBox x:Name="ProfileNameBox" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Každý profil má vlastnú mriežku a tlačidlá. Prepínaš ich v hornom pruhu decku, z mobilu alebo tlačidlom s akciou „Prepnúť profil“." />
                    </StackPanel>
                    <ListBox x:Name="ProfileList" MouseDoubleClick="ProfileList_MouseDoubleClick" />
                </DockPanel>
            </TabItem>

            <!-- ───────────── Mobil ───────────── -->
            <TabItem Header="Mobil">
                <StackPanel Margin="8,16,8,8">
                    <CheckBox x:Name="RemoteEnabledBox" Content="Povoliť ovládanie z mobilu" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Mobil musí byť v rovnakej Wi-Fi ako PC. Nič sa neinštaluje, beží to v prehliadači." />

                    <Grid x:Name="RemotePanel" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="184" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="184" Height="184" Background="White" CornerRadius="10" VerticalAlignment="Top">
                            <Image x:Name="QrImage" Margin="6" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Naskenuj kód fotoaparátom mobilu." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBlock Text="Adresa PC" Opacity="0.85" Margin="0,0,0,4" />
                            <ComboBox x:Name="AddressBox" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Port" Opacity="0.85" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="RemotePortBox" Width="80" HorizontalAlignment="Left" />
                            </DockPanel>
                            <WrapPanel>
                                <Button Content="Kopírovať odkaz" Click="CopyUrl_Click" Margin="0,0,8,8" />
                                <Button Content="Nový kód" Click="NewToken_Click" Margin="0,0,0,8"
                                        ToolTip="Vytvorí nový QR kód. Zariadenia so starým kódom sa odpoja." />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="UrlBox" IsReadOnly="True" Margin="0,12,0,0" FontSize="12" />
                    <TextBlock x:Name="RemoteStatus" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Ak sa mobil nevie pripojiť, povoľ Stream Deck vo Windows Firewall pre súkromné siete (Windows sa na to pri prvom zapnutí opýta)." />
                </StackPanel>
            </TabItem>

            <!-- ───────────── OBS ───────────── -->
            <TabItem Header="OBS">
                <StackPanel Margin="8,16,8,8">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                               Text="V OBS zapni Nástroje → Nastavenia WebSocket servera → Povoliť WebSocket server. Heslo skopíruješ cez „Zobraziť informácie o pripojení“." />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Adresa a port" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" x:Name="ObsHostBox" />
                        <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox Grid.Column="3" x:Name="ObsPortBox" />
                        <TextBlock Grid.Row="1" Text="Heslo" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <PasswordBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ObsPasswordBox" Margin="0,10,0,0" />
                    </Grid>
                    <Button Content="Otestovať pripojenie" HorizontalAlignment="Left" Click="ObsTest_Click" />
                    <TextBlock x:Name="ObsStatus" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
