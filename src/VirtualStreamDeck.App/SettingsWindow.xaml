<Window x:Class="VirtualStreamDeck.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastavenia"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ThemeMode="Dark">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Mriežka" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Riadky" Style="{StaticResource FieldLabel}" />
            <Slider Grid.Row="0" Grid.Column="1" x:Name="RowsSlider" Minimum="1" Maximum="10"
                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Value}"
                       Text="{Binding Value, ElementName=RowsSlider, StringFormat={}{0:0}}" />

            <TextBlock Grid.Row="1" Text="Stĺpce" Style="{StaticResource FieldLabel}" />
            <Slider Grid.Row="1" Grid.Column="1" x:Name="ColumnsSlider" Minimum="1" Maximum="12"
                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"
                       Text="{Binding Value, ElementName=ColumnsSlider, StringFormat={}{0:0}}" />

            <TextBlock Grid.Row="2" Text="Veľkosť tlačidiel" Style="{StaticResource FieldLabel}" />
            <Slider Grid.Row="2" Grid.Column="1" x:Name="SizeSlider" Minimum="40" Maximum="200"
                    TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}"
                       Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0}}" />

            <TextBlock Grid.Row="3" Text="Medzery" Style="{StaticResource FieldLabel}" />
            <Slider Grid.Row="3" Grid.Column="1" x:Name="SpacingSlider" Minimum="0" Maximum="40"
                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}"
                       Text="{Binding Value, ElementName=SpacingSlider, StringFormat={}{0:0}}" />
        </Grid>

        <TextBlock x:Name="HiddenInfo" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Text="Správanie" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <CheckBox x:Name="TopmostBox" Content="Vždy navrchu" Margin="0,0,0,4" />
        <CheckBox x:Name="LabelsBox" Content="Zobrazovať popisky pod ikonami" Margin="0,0,0,4" />
        <CheckBox x:Name="AutostartBox" Content="Spustiť so systémom Windows" Margin="0,0,0,20" />

        <TextBlock Text="OBS Studio" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="V OBS zapni Nástroje → Nastavenia WebSocket servera → Povoliť WebSocket server. Heslo skopíruješ cez „Zobraziť informácie o pripojení“." />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Adresa a port" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" x:Name="ObsHostBox" />
            <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="6,0" />
            <TextBox Grid.Column="3" x:Name="ObsPortBox" />
            <TextBlock Grid.Row="1" Text="Heslo" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
            <PasswordBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ObsPasswordBox" Margin="0,10,0,0" />
        </Grid>
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Left" Content="Otestovať pripojenie" Click="ObsTest_Click" />
            <TextBlock x:Name="ObsStatus" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" />
        </DockPanel>

        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Otvoriť priečinok s nastaveniami" Click="OpenFolder_Click" />
            <Button DockPanel.Dock="Right" Content="Zavrieť" IsCancel="True" IsDefault="True" MinWidth="90" />
        </DockPanel>
    </StackPanel>
</Window>
