<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VirtualStreamDeck.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The phone web app, served by Remote/RemoteServer. Resource names: VirtualStreamDeck.Core.Remote.web.<file> -->
    <EmbeddedResource Include="Remote\web\*" LogicalName="VirtualStreamDeck.Core.Remote.web.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VirtualStreamDeck.Core.Tests" />
  </ItemGroup>

</Project>
